# ChartPilot backend — required environment variables (Phase 2 skeleton).
# Copy this file to `.env` and fill in real values for local development.
# NEVER commit a `.env` file with real values — only this placeholder file.

# GCP project id for the isolated ChartPilot project (TD-002). Placeholder only.
GCP_PROJECT_ID=your-new-isolated-project-id

# GCP region for Cloud Run / Cloud Tasks / Firestore.
GCP_REGION=asia-south1

# Gemini model ids (discovered + pinned per SPEC §8 / TD-003). Placeholders only.
MODEL_A_ID=gemini-3.7-flash
MODEL_B_ID=gemini-3.5-flash

# Gemini Developer API key (new, isolated key — do NOT reuse an existing project's key).
# NEVER commit a real key. This placeholder is safe to commit.
GEMINI_API_KEY=REPLACE_ME_do_not_commit_real_key

# Optional. Must default to false; never implicitly true (spec §54).
ALLOW_SYNTHETIC_DEBUG_LOGS=false
